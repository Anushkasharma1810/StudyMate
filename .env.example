# ======================================================
# StudyMate environment configuration
# Copy this file to `.env` for local development.
# On a hosting provider, set these as environment variables instead
# (never commit a real .env file or API key to git).
# ======================================================

# --- Server ---
PORT=5000
# Use `production` on the live server
NODE_ENV=development

# Signs login tokens. REQUIRED in production (min 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- AI (configured once by the site owner; users never need a key) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: used automatically if the Gemini key is missing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Storage ---
# Where the SQLite database and uploaded files are kept.
# On a host, point both at a persistent disk/volume, e.g. a volume mounted at /data:
#   DATA_DIR=/data/db
#   UPLOADS_DIR=/data/uploads
DATA_DIR=./data
UPLOADS_DIR=./uploads

# --- Usage limits (protect the shared AI key's quota) ---
AI_LIMIT_PER_USER_10MIN=40
AI_LIMIT_PER_IP_10MIN=80
AI_LIMIT_GLOBAL_PER_DAY=1000
UPLOAD_LIMIT_PER_USER_HOUR=20
